<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
  <Box style={{ width: '100%', height: 72, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>结论与展望</Text>
    <Text style={{ fontSize: 14, color: '#BBD0EF' }}>04 · 总结与展望</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', padding: 32, gap: 28 }}>
    <Box style={{ width: '32%', background: '#0E3F8C', borderRadius: 10, padding: 28, flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF', marginBottom: 16 }}>主要结论</Text>
      <Text style={{ fontSize: 16, color: '#BBD0EF', lineHeight: 1.8 }}>
        双引擎融合在<span style={{ color: '#FFFFFF', fontWeight: 'bold' }}>可解释性</span>与<span style={{ color: '#FFFFFF', fontWeight: 'bold' }}>未知攻击覆盖率</span>之间取得平衡；规则引擎负责已知模式，机器学习负责异常发现，融合策略统一输出。
      </Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 18, justifyContent: 'center' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#D9534F', marginBottom: 2 }}>当前不足</Text>
      <Box style={{ background: '#FDECEC', borderRadius: 8, padding: 16 }}>
        <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>合成数据与真实流量分布存在差距；未覆盖加密流量（TLS 元数据分析）。</Text>
      </Box>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 2 }}>改进方向</Text>
      <Box style={{ background: '#E8EFF8', borderRadius: 8, padding: 16 }}>
        <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>接入 NSL-KDD / CICIDS-2017 真实数据集；增加时序模型（LSTM / AutoEncoder）对比；支持 PCAP 文件实时解析。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 40, borderTop: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-end', paddingRight: 40 }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>12 / 13</Text>
  </Box>
</Slide>
