<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
  <Box style={{ width: '100%', height: 72, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>双引擎融合架构</Text>
    <Text style={{ fontSize: 14, color: '#BBD0EF' }}>02 · 系统设计</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', padding: 32, gap: 28, alignItems: 'stretch' }}>
    <Box style={{ width: '32%', flexDirection: 'column', justifyContent: 'center', gap: 18 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>架构总览</Text>
      <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
        流量经特征提取后，并行送入<span style={{ color: '#1E4FA8', fontWeight: 'bold' }}>规则引擎</span>与<span style={{ color: '#1E4FA8', fontWeight: 'bold' }}>机器学习引擎</span>。
      </Text>
      <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
        <span style={{ fontWeight: 'bold', color: '#1A2230' }}>融合策略</span>：规则优先采信、ML 兜底分类、异常分修正可疑连接。
      </Text>
      <Box style={{ background: '#E8EFF8', borderRadius: 8, padding: 16 }}>
        <Text style={{ fontSize: 15, color: '#0E3F8C', lineHeight: 1.6 }}>
          该混合架构与工业界 Snort / Suricata 的"规则主导 + 统计辅助"思路一致。
        </Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, background: '#F7F9FC', borderRadius: 10, alignItems: 'center', justifyContent: 'center' }}>
      <svg width={600} height={470} viewBox='0 0 640 500'>
        <defs>
          <marker id='ar' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='7' markerHeight='7' orient='auto-start-reverse'>
            <path d='M2 1L8 5L2 9' fill='none' stroke='#8B97A8' strokeWidth='1.5' strokeLinecap='round' strokeLinejoin='round' />
          </marker>
        </defs>
        <rect x='210' y='24' width='220' height='54' rx='8' fill='#FFFFFF' stroke='#1E4FA8' strokeWidth='1.5' />
        <text x='320' y='56' textAnchor='middle' fontSize='17' fontWeight='bold' fill='#1A2230'>网络流量 · 9 维特征</text>
        <line x1='290' y1='78' x2='150' y2='140' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#ar)' />
        <line x1='350' y1='78' x2='490' y2='140' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#ar)' />
        <rect x='50' y='150' width='200' height='92' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='1.5' />
        <text x='150' y='184' textAnchor='middle' fontSize='18' fontWeight='bold' fill='#0E3F8C'>规则引擎</text>
        <text x='150' y='212' textAnchor='middle' fontSize='14' fill='#4A5568'>5 条白盒规则 · 可解释</text>
        <rect x='390' y='150' width='200' height='92' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='1.5' />
        <text x='490' y='184' textAnchor='middle' fontSize='18' fontWeight='bold' fill='#0E3F8C'>机器学习引擎</text>
        <text x='490' y='210' textAnchor='middle' fontSize='13' fill='#4A5568'>IsolationForest + RandomForest</text>
        <line x1='150' y1='242' x2='320' y2='312' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#ar)' />
        <line x1='490' y1='242' x2='320' y2='312' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#ar)' />
        <rect x='200' y='320' width='240' height='66' rx='8' fill='#0E3F8C' />
        <text x='320' y='345' textAnchor='middle' fontSize='17' fontWeight='bold' fill='#FFFFFF'>融合策略</text>
        <text x='320' y='368' textAnchor='middle' fontSize='13' fill='#BBD0EF'>规则优先 · ML 兜底 · 异常分修正</text>
        <line x1='320' y1='386' x2='320' y2='424' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#ar)' />
        <rect x='200' y='424' width='240' height='56' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='1.5' />
        <text x='320' y='457' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#1E4FA8'>告警 · 可视化仪表盘</text>
      </svg>
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 40, borderTop: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-end', paddingRight: 40 }}>
